# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB — Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quantedge?retryWrites=true&w=majority

# CORS — the public site's origin(s), comma-separated. Include your deployed
# domain once live; localhost is for local frontend dev.
CLIENT_ORIGINS=http://localhost:5173,https://www.quantedgecs.com

# Auth — long random string used to sign admin JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email notifications — Resend (resend.com). Free tier covers this site's
# expected volume. Get an API key after verifying a sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_FROM_EMAIL=QuantEdge Website <notifications@quantedgecs.com>
NOTIFY_TO_EMAIL=info@quantedgecs.com

# Chat widget — Groq API key (free, no card required): console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
